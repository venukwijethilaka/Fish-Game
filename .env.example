PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
# Optional Google web client ID. Login is hidden until configured.
GOOGLE_CLIENT_ID=
# Set a long random secret before any non-local deployment.
JWT_SECRET=
# Database Configuration:
# - To use Neon Serverless PostgreSQL (Cloud), uncomment and fill in your neon.tech connection URI:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123456.eu-west-1.aws.neon.tech/neondb?sslmode=require
# - When DATABASE_URL is unset, the app automatically runs on local embedded SQLite:
LOCAL_DB_PATH=var/reef.sqlite
FISH_API_BASE=https://marcconrad.com/uob/fish/api.php
